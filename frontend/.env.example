# Base URL the browser uses for API calls. Defaults to "/api", which the Vite
# dev server proxies to the Rust API (see vite.config.ts).
# Set to e.g. http://127.0.0.1:8080 to call the API directly (CORS is enabled
# for http://localhost:5173 in the backend).
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
