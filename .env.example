# Copy to backend/.env  (cp .env.example backend/.env)

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://taskapp:taskapp@localhost:5432/taskapp

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Address the API binds to
BIND_ADDR=127.0.0.1:8080

# development | production
# In development the /dev/email-logs/latest and /seed/users endpoints are enabled.
APP_ENV=development

# Secrets - change these for anything other than local development
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
OTP_SECRET=change-me-otp-hmac-secret-at-least-32-chars

# Token / cache lifetimes
JWT_TTL_MINUTES=60
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
CACHE_TTL_SECONDS=300

# Comma separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173

RUST_LOG=task_api=debug,tower_http=info
